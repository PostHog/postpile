{
  "name": "@postpile/desktop",
  "productName": "PostPile",
  "version": "0.8.0",
  "description": "PostPile desktop app: Electron shell, Mac notifications and the React UI",
  "private": true,
  "license": "MIT",
  "author": "PostHog Inc. (https://posthog.com)",
  "homepage": "https://github.com/PostHog/postpile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PostHog/postpile.git",
    "directory": "apps/desktop"
  },
  "bugs": {
    "url": "https://github.com/PostHog/postpile/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
