#!/bin/sh
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
app="$(cd "$(dirname "$self")/../.." && pwd)"
case "$1" in
  "")
    exec open "$app"
    ;;
  browser)
    shift
    ELECTRON_RUN_AS_NODE=1 exec "$app/Contents/MacOS/PostPile" "$app/Contents/Resources/app.asar/out/main/browser.js" "$@"
    ;;
  *)
    echo "Usage: postpile [browser [--at-login | --stop | --restart]]" >&2
    exit 2
    ;;
esac
