{
  "name": "@postpile/cli",
  "version": "0.12.4",
  "description": "PostPile dev CLI: sync, poll, sweep and read topics from the terminal",
  "private": true,
  "license": "MIT",
  "author": "PostHog Inc. (https://posthog.com)",
  "homepage": "https://github.com/PostHog/postpile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PostHog/postpile.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/PostHog/postpile/issues"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "POSTPILE_PROFILE=${POSTPILE_PROFILE:-dev} tsx src/main.ts"
  },
  "dependencies": {
    "@postpile/core": "workspace:*",
    "@postpile/engine": "workspace:*",
    "@postpile/mcp": "workspace:*",
    "@postpile/server": "workspace:*"
  },
  "bin": {
    "postpile": "./src/main.ts"
  }
}
