{
  "name": "@postpile/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@postpile/core": "workspace:*",
    "@postpile/engine": "workspace:*",
    "@postpile/server": "workspace:*"
  },
  "bin": {
    "postpile": "./src/main.ts"
  }
}
