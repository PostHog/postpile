{
  "name": "postpile",
  "version": "0.11.1",
  "description": "A macOS app one level above GitHub PRs: agent-maintained topics instead of a notification pile",
  "private": true,
  "license": "MIT",
  "author": "PostHog Inc. (https://posthog.com)",
  "homepage": "https://github.com/PostHog/postpile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PostHog/postpile.git"
  },
  "bugs": {
    "url": "https://github.com/PostHog/postpile/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @postpile/desktop build",
    "cli": "POSTPILE_PROFILE=${POSTPILE_PROFILE:-dev} tsx apps/cli/src/main.ts",
    "server": "pnpm --filter @postpile/server start",
    "desktop": "pnpm --filter @postpile/desktop dev",
    "dist": "pnpm build && pnpm --filter @postpile/desktop dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
