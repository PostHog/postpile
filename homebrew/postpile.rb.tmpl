# typed: false
# frozen_string_literal: true

# Rendered into PostHog/homebrew-tap as Casks/postpile.rb by
# .github/workflows/release.yml on v* tags. Edit this template, not the
# rendered file in the tap; the next release overwrites it.
#
# The first block in the caveats, between its two marker lines, is for ad-hoc
# signed builds only. The workflow deletes the whole block for a Developer ID
# signed and notarized build, and only the two marker lines for an ad-hoc one.
# Don't write the marker names anywhere else in this file.
cask "postpile" do
  version "VERSION_PLACEHOLDER"
  sha256 "SHA256_PLACEHOLDER"

  url "https://github.com/PostHog/postpile/releases/download/v#{version}/PostPile-#{version}-mac-arm64.zip"
  name "PostPile"
  desc "Turns GitHub PR notifications into agent-maintained topics"
  homepage "https://github.com/PostHog/postpile"

  # The app downloads and installs new releases itself (DESIGN.md "Self-update"),
  # so brew leaves an app that is already newer than this cask alone.
  auto_updates true
  depends_on arch: :arm64
  depends_on macos: :monterey

  app "PostPile.app"
  # Read-only MCP server for other agents; the script follows this symlink back into the app.
  binary "#{appdir}/PostPile.app/Contents/Resources/postpile-mcp"

  # After the app stages a self-update, Squirrel's ShipIt waits as a launchd job
  # and installs the staged bundle when PostPile quits. It checks only the
  # bundle ID and the code signature, not the version, so a `brew upgrade` with
  # an older update still staged would be overwritten by that older version on
  # the next quit. brew runs launchctl before quit (its uninstall directives are
  # ordered), also on upgrade: the waiting job goes first, then the app quits,
  # and brew reopens it after the upgrade. Same pattern as the visual-studio-code cask.
  uninstall launchctl: "com.posthog.postpile.ShipIt",
            quit:      "com.posthog.postpile"

  # Exact paths on purpose: a PostPile* glob would also catch the dev-run
  # folders. com.postpile.app is the bundle ID of the early ad-hoc builds.
  zap trash: [
    "~/.config/postpile",
    "~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/com.posthog.postpile.sfl*",
    "~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/com.postpile.app.sfl*",
    "~/Library/Application Support/PostPile",
    "~/Library/Caches/@postpiledesktop-updater",
    "~/Library/Caches/com.posthog.postpile",
    "~/Library/Caches/com.posthog.postpile.ShipIt",
    "~/Library/HTTPStorages/com.posthog.postpile",
    "~/Library/Logs/PostPile",
    "~/Library/Preferences/ByHost/com.posthog.postpile.ShipIt.*.plist",
    "~/Library/Preferences/com.posthog.postpile.plist",
    "~/Library/Preferences/com.postpile.app.plist",
    "~/Library/Saved Application State/com.posthog.postpile.savedState",
  ]

  caveats <<~EOS
    ADHOC_CAVEAT_BEGIN
    PostPile is an alpha and this build is not notarized (ad-hoc signed only),
    so macOS blocks the first open. Either clear the quarantine flag:

      xattr -dr com.apple.quarantine /Applications/PostPile.app

    or try to open it once, then allow it in System Settings > Privacy &
    Security > Open Anyway (on older macOS: right-click the app > Open).
    This build can't update itself: update with brew upgrade --cask postpile.

    ADHOC_CAVEAT_END
    PostPile needs the GitHub CLI and the Claude Code CLI, both installed
    and logged in:

      brew install gh && gh auth login
      curl -fsSL https://claude.ai/install.sh | bash && claude auth login

    Let other agents ask PostPile about your PRs (read-only):

      claude mcp add postpile -- postpile-mcp

    PostPile updates itself: when a new release is downloaded, the title bar
    offers a restart. brew upgrade --cask postpile works too.
  EOS
end
